# Segredos — todas as chaves de API vivem aqui, nunca no código.
.env
.env.local
*.pem
*.key
credentials.json
token.json

# Freio de emergencia: a presenca deste arquivo bloqueia toda
# publicacao. E estado da maquina, nao do projeto.
PARAR_PUBLICACAO

# Banco: fonte de verdade em runtime, não artefato de código. Os arquivos
# -wal/-shm são do WAL mode e mudam a cada escrita.
*.db
*.db-wal
*.db-shm

# Configuração operacional que o próprio sistema reescreve (analytics remove
# canais de baixa performance). Versionado é o canais.exemplo.json.
sourcing/canais.json

# Mídia baixada, intermediária e renderizada — pesada e toda reconstruível a
# partir da fila. Inclui os .mp3 fatiados para a Whisper API, os .json de
# transcrição e os .ass/.mp4 de cada clip.
downloads/
render/
clips/
*.mp4
*.mkv
*.webm
*.wav
*.mp3
*.ass

# Efeitos sonoros: binários grandes, licenciados individualmente. Versionados
# são o template_config.json que os referencia e o README que diz quais são.
assets/sfx/*
!assets/sfx/README.md

# Bancada de teste local: video sintetico, transcricao e render de
# validacao. Reproduzivel por teste_local/primeiro_clip.py.
teste_local/

# Ambiente e cache do Python.
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor e sistema operacional.
.vscode/
.idea/
.DS_Store
Thumbs.db
