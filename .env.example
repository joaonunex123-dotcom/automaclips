# Copie para .env e preencha. O .env NUNCA entra no git (ver .gitignore).

# --- chaves de API ------------------------------------------------------------

# YouTube Data API v3 — console.cloud.google.com > APIs > Credenciais > Chave
# de API. Usada só para leitura pública (listar uploads e estatísticas), então
# chave de API basta; o upload da etapa 6 vai precisar de OAuth, que é outra
# credencial.
YOUTUBE_API_KEY=

# Claude API — usada a partir da etapa 2 (highlight_detect).
ANTHROPIC_API_KEY=

# OpenAI — usada pela transcrição (Whisper API). Com esta chave preenchida, o
# pipeline passa a transcrever pela API por padrão; sem ela, usa o
# faster-whisper local.
OPENAI_API_KEY=

# OpenRouter — usada pelas etapas de menor exigência (metadado, e a
# recalibração da etapa 7). O highlight_detect NÃO passa por aqui: escolher o
# trecho continua no Claude direto.
OPENROUTER_API_KEY=

# Quem paga a conta do metadado e da recalibracao: openrouter | openai.
# Os dois falam o mesmo protocolo pelo mesmo SDK -- muda a base_url e a chave.
LLM_PROVEDOR=
OPENAI_BASE_URL=

# Quem escolhe o TRECHO: anthropic (padrao) | openai.
#
# Trocar e decisao de CUSTO, nao de conveniencia. Fora da Anthropic perde-se a
# saida estruturada GARANTIDA (o JSON passa a ser pedido, e depende do extrator
# tolerante e do MODEL_FALLBACK), o cache de prompt e o fallback server-side.
HIGHLIGHT_PROVEDOR=
MODEL_HIGHLIGHT=

# Modelos por etapa. Se um slug estiver errado, a chamada volta 404 com o nome
# dentro — corrigir é mexer aqui, não no código.
MODEL_METADATA=
MODEL_RECALIBRATE=
# Refaz a chamada quando o modelo principal devolve resposta ininteligível.
MODEL_FALLBACK=
OPENROUTER_BASE_URL=
OPENROUTER_MAX_RETRIES=

# --- modo sombra --------------------------------------------------------------

# Com false, o pipeline gera o clip inteiro mas NÃO posta. É assim que a
# qualidade é validada antes de qualquer coisa ir ao ar.
#
# Virar para true faz os posts irem ao ar DE VERDADE, e não há desfazer.
# Antes: python -m orchestrator.main_loop --verificar
AUTO_PUBLISH=false

# --- sourcing -----------------------------------------------------------------

# Corte do score (views ganhas por hora). Vídeo abaixo disso é registrado mas
# fica fora da fila de processamento. O número certo depende do tamanho dos
# canais que você monitora — comece observando a tabela e ajuste.
SCORE_THRESHOLD=

# Quantos uploads recentes olhar por canal a cada varredura.
SOURCING_MAX_VIDEOS_POR_CANAL=

# Vídeo mais velho que isto nem é pontuado (já passou da janela de momento).
SOURCING_IDADE_MAXIMA_HORAS=

# Piso do denominador do score: sem ele, um vídeo de 3 minutos de idade com 20
# views marca 400 views/h e domina o ranking por puro ruído.
SOURCING_IDADE_MINIMA_HORAS=

# Faixa de duração do vídeo-FONTE (segundos). O mínimo evita puxar Shorts
# (nada a recortar); o máximo evita transcrever um podcast de 4 horas.
SOURCING_DURACAO_MINIMA_S=
SOURCING_DURACAO_MAXIMA_S=

# --- pipeline (etapa 2) -------------------------------------------------------

# Modelo e profundidade de raciocínio do highlight_detect.
# CLAUDE_EFFORT: low | medium | high | xhigh | max
CLAUDE_MODELO=
CLAUDE_EFFORT=
CLAUDE_MAX_TOKENS=
CLAUDE_MAX_RETRIES=

# Fallback server-side quando os classificadores recusam a transcrição.
# 0 desliga (a recusa passa a derrubar o vídeo).
CLAUDE_FALLBACKS=

# Quantos trechos pedir por vídeo, e a faixa de duração de cada um.
CLIPS_POR_VIDEO=
CLIP_DURACAO_MINIMA_S=
CLIP_DURACAO_MAXIMA_S=

# Corte do score final do trecho (escala 0–10).
CLIP_SCORE_THRESHOLD=

# Guarda de custo: transcrição acima deste tamanho não é enviada à API.
TRANSCRICAO_MAX_TOKENS=

# Vídeos processados por execução do pipeline.
PIPELINE_MAX_VIDEOS=

# Transcrição (faster-whisper). Com GPU: WHISPER_DEVICE=cuda e
# WHISPER_COMPUTE_TYPE=float16. WHISPER_IDIOMA vazio = detecção automática.
WHISPER_MODELO=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
WHISPER_IDIOMA=

# --- transcrição pela OpenAI --------------------------------------------------

# local | openai | youtube | vazio (decide pela presença de OPENAI_API_KEY).
#
# 'youtube' e o mais barato: usa a legenda que o proprio YouTube ja tem, sem
# chave, sem modelo e sem CPU. NAO entra na escolha automatica porque depende
# de o video ter legenda -- quem quer, pede.
TRANSCRICAO_BACKEND=

# Idiomas de legenda tentados, na ordem (aceita curinga: pt.*).
YOUTUBE_LEGENDAS_IDIOMAS=

# auto | manual. A automatica traz timestamp por PALAVRA (necessario para a
# legenda word-by-word) e texto pior; a manual traz texto melhor e timestamp
# so por frase. Padrao: auto.
YOUTUBE_LEGENDAS_PREFERIR=

# whisper-1 é o modelo que devolve timestamp por palavra. Trocar por um que
# não devolva quebra a legenda word-by-word da etapa 3.
OPENAI_WHISPER_MODELO=

# Preparo do áudio antes de subir: bitrate do mp3, teto de upload e duração
# máxima de cada fatia.
OPENAI_MP3_BITRATE=
OPENAI_UPLOAD_MAX_MB=
OPENAI_CHUNK_MAX_S=

# Onde procurar silêncio para o corte da fatia não cair no meio de uma palavra.
OPENAI_CORTE_SILENCIO_DB=
OPENAI_CORTE_SILENCIO_MIN_S=
OPENAI_CORTE_TOLERANCIA_S=

# --- orçamento ----------------------------------------------------------------

# Preço publicado do whisper-1 por minuto de áudio. CONFERIR contra a tabela
# vigente da OpenAI: é daqui que saem a estimativa e o corte de orçamento.
WHISPER_API_USD_POR_MINUTO=

# Teto de gasto acumulado, em USD. A transcrição que ultrapassaria é recusada
# ANTES de subir o arquivo. 0 desliga a guarda.
ORCAMENTO_USD=

# --- editing (etapa 3) --------------------------------------------------------

# Só caminho e volume. Todo parâmetro visual mora em
# editing/template_config.json.
TEMPLATE_CONFIG_PATH=
CLIPS_RENDER_DIR=
EDITING_MAX_CLIPS=

# Detecção de picos de energia no áudio.
ENERGIA_JANELA_S=
ENERGIA_PERCENTIL=
ENERGIA_DISTANCIA_MINIMA_S=

# Fator aplicado ao score do Claude conforme a densidade de picos do trecho.
FATOR_ENERGIA_MIN=
FATOR_ENERGIA_MAX=
DENSIDADE_PICOS_PLENA=

# Seletor de formato do yt-dlp e taxa do áudio de trabalho.
YTDLP_FORMATO=
CLIPS_AUDIO_SAMPLE_RATE=

# --- publish (etapa 5) --------------------------------------------------------

# Para onde publicar, separado por vírgula: youtube,instagram,tiktok
# Vazio = youtube,instagram (mais tiktok, se PUBLICAR_TIKTOK=true).
PLATAFORMAS=

# Publicações por dia e por plataforma, e os horários de queda (HH:MM local).
# Os horários são o FALLBACK — a partir da etapa 7 o histórico de engajamento
# manda, e estes três são palpite. Troque pelos seus.
POSTS_POR_DIA=
HORARIOS_PADRAO=

# Ritmo diferente por plataforma: 'tiktok=4,instagram=2'. Vale para quem
# estiver listado; o resto segue o POSTS_POR_DIA acima.
POSTS_POR_DIA_PLATAFORMA=

# Distância mínima entre dois posts na mesma plataforma, e até quantos dias à
# frente o scheduler pode marcar.
INTERVALO_MINIMO_MIN=
AGENDAMENTO_MAX_DIAS=

# Quota do YouTube: 1600 unidades por upload, teto de 10.000 por dia. O dia
# zera à meia-noite do Pacífico — não mude o fuso sem motivo.
YOUTUBE_QUOTA_DIARIA=
YOUTUBE_CUSTO_UPLOAD=
QUOTA_FUSO=

# OAuth do YouTube (credencial diferente da YOUTUBE_API_KEY do sourcing).
# Baixe o client secret tipo "Aplicativo para computador" no Google Cloud e
# rode `python -m publish.publicar --autorizar` uma vez.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_OAUTH_TOKEN=
# 22 = People & Blogs. Deixe em 'private' até conferir os primeiros clips.
YOUTUBE_CATEGORIA=
YOUTUBE_PRIVACIDADE=

# Instagram. O token de longa duração INICIAL vai aqui; depois da primeira
# renovação o valor vigente passa a viver na tabela `tokens` do banco.
INSTAGRAM_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_TOKEN_INICIAL=
INSTAGRAM_API_BASE=
INSTAGRAM_RENOVAR_ANTES_DIAS=

# URL pública da pasta render/. O Instagram BAIXA o vídeo por HTTP e não
# aceita upload de arquivo — sem isto, a publicação no Instagram é impossível.
# O TikTok só precisa dela se TIKTOK_MODO_UPLOAD=url.
CLIPS_BASE_URL=

# --- TikTok -------------------------------------------------------------------
#
# Content Posting API. Precisa de um app criado em developers.tiktok.com, com
# os escopos video.publish e user.info.basic, e da conta do canal autorizada
# nele. As três primeiras chaves saem do painel do app; o access e o refresh
# token saem do fluxo OAuth que você roda uma vez.
#
# LEIA ANTES DE LIGAR: enquanto o app não passar pela revisão da TikTok, TODO
# post sai como SELF_ONLY — sobe para a conta e só você vê. Não é bug da
# integração, não tem contorno, e a revisão leva dias ou semanas. Ligue
# TIKTOK_APP_AUDITADO só quando ela for aprovada.
PUBLICAR_TIKTOK=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# O access token vale ~24 h; sem o refresh a fila para amanhã sozinha.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_API_BASE=
TIKTOK_RENOVAR_ANTES_S=

# SELF_ONLY (padrão) ou PUBLIC_TO_EVERYONE. Um app não revisado só aceita o
# primeiro, e o código rebaixa sozinho avisando no log quando for o caso.
TIKTOK_PRIVACIDADE=
TIKTOK_APP_AUDITADO=

# 'arquivo' (padrão) envia os bytes; 'url' manda a TikTok baixar de
# CLIPS_BASE_URL — e o modo url ainda exige verificar o domínio no painel.
TIKTOK_MODO_UPLOAD=
TIKTOK_CHUNK_MB=

# Limites do vídeo conferidos ANTES de subir. A duração máxima de verdade vem
# da própria conta, na hora de publicar.
TIKTOK_DURACAO_MAXIMA_S=
TIKTOK_TAMANHO_MAXIMO_MB=
TIKTOK_FORMATOS=

TIKTOK_DESABILITAR_COMENTARIO=
TIKTOK_DESABILITAR_DUETO=
TIKTOK_DESABILITAR_STITCH=

# Limites de texto das plataformas e teto de hashtags.
LIMITE_TITULO_YOUTUBE=
LIMITE_DESCRICAO_YOUTUBE=
LIMITE_CAPTION_INSTAGRAM=
# TikTok: o teto da API e o alvo do CORPO da legenda (o que aparece no feed
# antes do "mais"). As hashtags entram depois do corpo.
LIMITE_CAPTION_TIKTOK=
LIMITE_CORPO_TIKTOK=
MAX_HASHTAGS=

PUBLISH_MAX_POR_EXECUCAO=

# --- publicacao real e orchestrator (etapa 6) ---------------------------------

# A chave que liga a publicacao real e o AUTO_PUBLISH la em cima, na secao
# "modo sombra". ATENCAO: com true os posts vao ao ar e nao ha desfazer.
# Antes de ligar, rode:  python -m orchestrator.main_loop --verificar

# Teto absoluto de posts por dia e por plataforma, independente do scheduler.
# Backstop contra bug de agenda, nao configuracao de ritmo. O override por
# plataforma segue o mesmo formato do POSTS_POR_DIA_PLATAFORMA:
# 'tiktok=4,youtube=6'.
MAX_POSTS_DIA_ABSOLUTO=
MAX_POSTS_DIA_ABSOLUTO_PLATAFORMA=

# Aquecimento: nos primeiros dias de publicacao real, no maximo este numero de
# posts por dia. O relogio comeca no primeiro post que foi ao ar. 0 desliga.
AQUECIMENTO_POSTS_DIA=
AQUECIMENTO_DIAS=

# Ritmo do laco principal, em minutos, e a hora do analytics diario (HH:MM).
INTERVALO_SOURCING_MIN=
INTERVALO_PIPELINE_MIN=
INTERVALO_EDITING_MIN=
INTERVALO_PUBLISH_MIN=
HORARIO_ANALYTICS=

# --- analytics e recalibracao (etapa 7) ---------------------------------------

# Janela de medicao: post mais novo que o minimo ainda esta na distribuicao
# inicial da plataforma; mais velho que o maximo ja estabilizou.
ANALYTICS_IDADE_MINIMA_H=
ANALYTICS_IDADE_MAXIMA_H=
ANALYTICS_HORAS_MINIMAS=

# Retencao media exige a YouTube Analytics API (OUTRO escopo de OAuth). Sem
# ela a recalibracao de duracao usa views/hora por faixa. 1 liga.
ANALYTICS_RETENCAO=

# Quanto dado e "dado suficiente". Abaixo de cada minimo, a recalibracao
# correspondente simplesmente nao acontece e o default acima continua valendo.
RECALIBRAR_PERCENTIL_TOPO=
RECALIBRAR_MIN_CLIPS=
RECALIBRAR_MAX_EXEMPLOS=
RECALIBRAR_MIN_CLIPS_CANAL=
RECALIBRAR_FRACAO_CANAL_RUIM=
RECALIBRAR_FAIXA_DURACAO_S=
RECALIBRAR_MIN_CLIPS_FAIXA=
RECALIBRAR_MIN_POSTS_HORARIO=

# --- caminhos -----------------------------------------------------------------

# Sobrescritos pelos testes para apontar a um arquivo temporário.
CLIPS_DB_PATH=
CANAIS_PATH=
CLIPS_DOWNLOADS_DIR=
CLIPS_TRANSCRICOES_DIR=
