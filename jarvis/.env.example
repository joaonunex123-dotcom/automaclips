# Copie para .env (fica fora do git) e preencha. Variável do ambiente vence o .env.

# Obrigatória. Gere com: openssl rand -hex 32
JARVIS_TOKEN=

# Provedor de LLM: mock (texto falso, para testar) | llamacpp (llama-server).
JARVIS_LLM=mock
# Atraso entre tokens do mock, em segundos.
JARVIS_MOCK_ATRASO_S=0.05

# llama-server (rodar à parte: llama-server -m modelo.gguf --port 8080).
LLAMA_URL=http://127.0.0.1:8080
LLAMA_TIMEOUT_S=120
LLAMA_MAX_TOKENS=512

# Fuso da casa: horários sem fuso são lidos aqui, e a API devolve neste fuso.
JARVIS_TZ=America/Sao_Paulo

# Banco SQLite (padrão: jarvis/dados/jarvis.db).
# JARVIS_DB_PATH=/home/orangepi/dados/jarvis.db

# Quantas mensagens anteriores entram no contexto do modelo.
JARVIS_HISTORICO_MSGS=10
# JARVIS_SYSTEM_PROMPT=Você é o Jarvis...

# Sensores. Padrão /sys/class/thermal; fora do Pi, a temperatura vem None.
JARVIS_THERMAL_DIR=/sys/class/thermal

# Origens liberadas por CORS (regex). Padrão: localhost e Tailscale.
# JARVIS_CORS_REGEX=

# Pasta servida em /. Padrão: jarvis/screen.
# JARVIS_TELA_DIR=
