# Copie para .env e preencha. O .env NUNCA entra no git (ver .gitignore).

# --- chaves de API ------------------------------------------------------------

# YouTube Data API v3 — console.cloud.google.com > APIs > Credenciais > Chave
# de API. Usada só para leitura pública (listar uploads e estatísticas), então
# chave de API basta; o upload da etapa 6 vai precisar de OAuth, que é outra
# credencial.
YOUTUBE_API_KEY=

# Claude API — usada a partir da etapa 2 (highlight_detect).
ANTHROPIC_API_KEY=

# --- modo sombra --------------------------------------------------------------

# Com false, o pipeline gera o clip inteiro mas NÃO posta. É assim que a
# qualidade é validada antes de qualquer coisa ir ao ar. Só vire true na
# etapa 6, depois de olhar clips renderizados de verdade.
AUTO_PUBLISH=false

# --- sourcing -----------------------------------------------------------------

# Corte do score (views ganhas por hora). Vídeo abaixo disso é registrado mas
# fica fora da fila de processamento. O número certo depende do tamanho dos
# canais que você monitora — comece observando a tabela e ajuste.
SCORE_THRESHOLD=

# Quantos uploads recentes olhar por canal a cada varredura.
SOURCING_MAX_VIDEOS_POR_CANAL=

# Vídeo mais velho que isto nem é pontuado (já passou da janela de momento).
SOURCING_IDADE_MAXIMA_HORAS=

# Piso do denominador do score: sem ele, um vídeo de 3 minutos de idade com 20
# views marca 400 views/h e domina o ranking por puro ruído.
SOURCING_IDADE_MINIMA_HORAS=

# Faixa de duração do vídeo-FONTE (segundos). O mínimo evita puxar Shorts
# (nada a recortar); o máximo evita transcrever um podcast de 4 horas.
SOURCING_DURACAO_MINIMA_S=
SOURCING_DURACAO_MAXIMA_S=

# --- pipeline (etapa 2) -------------------------------------------------------

# Modelo e profundidade de raciocínio do highlight_detect.
# CLAUDE_EFFORT: low | medium | high | xhigh | max
CLAUDE_MODELO=
CLAUDE_EFFORT=
CLAUDE_MAX_TOKENS=
CLAUDE_MAX_RETRIES=

# Fallback server-side quando os classificadores recusam a transcrição.
# 0 desliga (a recusa passa a derrubar o vídeo).
CLAUDE_FALLBACKS=

# Quantos trechos pedir por vídeo, e a faixa de duração de cada um.
CLIPS_POR_VIDEO=
CLIP_DURACAO_MINIMA_S=
CLIP_DURACAO_MAXIMA_S=

# Corte do score final do trecho (escala 0–10).
CLIP_SCORE_THRESHOLD=

# Guarda de custo: transcrição acima deste tamanho não é enviada à API.
TRANSCRICAO_MAX_TOKENS=

# Vídeos processados por execução do pipeline.
PIPELINE_MAX_VIDEOS=

# Transcrição (faster-whisper). Com GPU: WHISPER_DEVICE=cuda e
# WHISPER_COMPUTE_TYPE=float16. WHISPER_IDIOMA vazio = detecção automática.
WHISPER_MODELO=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
WHISPER_IDIOMA=

# Detecção de picos de energia no áudio.
ENERGIA_JANELA_S=
ENERGIA_PERCENTIL=
ENERGIA_DISTANCIA_MINIMA_S=

# Fator aplicado ao score do Claude conforme a densidade de picos do trecho.
FATOR_ENERGIA_MIN=
FATOR_ENERGIA_MAX=
DENSIDADE_PICOS_PLENA=

# Seletor de formato do yt-dlp e taxa do áudio de trabalho.
YTDLP_FORMATO=
CLIPS_AUDIO_SAMPLE_RATE=

# --- caminhos -----------------------------------------------------------------

# Sobrescritos pelos testes para apontar a um arquivo temporário.
CLIPS_DB_PATH=
CANAIS_PATH=
CLIPS_DOWNLOADS_DIR=
CLIPS_TRANSCRICOES_DIR=
