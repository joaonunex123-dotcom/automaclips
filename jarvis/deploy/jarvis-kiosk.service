[Unit]
Description=Jarvis na tela 800x480 (cage + chromium em modo kiosk)
Documentation=file:///home/orangepi/automaclips/jarvis/deploy/README.md
After=jarvis.service systemd-user-sessions.service getty@tty1.service
Wants=jarvis.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Troque se o usuário ou o caminho do clone forem outros (ver deploy/README.md).
User=orangepi
# PAMName=login abre uma sessão do logind, que dá ao cage o acesso ao tty1 e o XDG_RUNTIME_DIR.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /home/orangepi/automaclips/jarvis/deploy/kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
